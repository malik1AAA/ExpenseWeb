# Supabase Configuration
# Get these values from your Supabase project dashboard:
# https://app.supabase.com/project/_/settings/api

VITE_SUPABASE_URL=https://adasdas
VITE_SUPABASE_PUBLISHABLE_KEY=sb_

# IMPORTANT: 
# - Replace the values above with your actual Supabase credentials
# - Copy this file to .env.local and fill in your values
# - Never commit .env.local to version control
# - The publishable key is safe to expose in frontend code
# - Never use the service_role key in frontend code

# Server-only settings for the Vercel /api/send-email function.
# Never prefix these with VITE_.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM_NAME=ExpenseWeb
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
MAILER_SHARED_SECRET=generate-a-long-random-secret
